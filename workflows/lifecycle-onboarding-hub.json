      }
    },
    {
      "id": "sticky-s8",
      "name": "Lifecycle tracking",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, 1250],
      "parameters": {
        "content": "## Lifecycle tracking\n\nUpdate stage in Salesforce and Totango, Planhat, or Catalyst.\n\n*(Inactive for demo)*",
        "color": 1,
        "width": 280,
        "height": 140
      }
    },
    {
      "id": "sticky-s9",
      "name": "PHASE 4: DAY 7 FOLLOW-UP",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 1340],
      "parameters": {
        "content": "## 🔄 PHASE 4: DAY 7 FOLLOW-UP\n\nAI crafts a personalized check-in based on the customer's goals — not boilerplate. Pattern repeats for Day 14 & 30.",
        "color": 2,

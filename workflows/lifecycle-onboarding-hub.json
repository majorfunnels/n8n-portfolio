      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [100, 1610],
      "parameters": {
        "content": "## Personalization at scale\n\nEvery check-in tied to their goals. Not \"Day 7 of onboarding\" generic.",
        "color": 4,
        "width": 240,
        "height": 100
      }
    },
    {
      "id": "sticky-s11",
      "name": "Touchpoint logging",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [700, 1610],
      "parameters": {
        "content": "## Touchpoint logging\n\nRecord the check-in in Vitally or any CSP with timeline APIs.\n\n*(Inactive for demo)*",
        "color": 1,

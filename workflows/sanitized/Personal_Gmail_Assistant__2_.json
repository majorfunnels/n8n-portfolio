          "categories": [
            {
              "category": "AI-Agent/Personal",
              "description": "Emails from friends, family, and direct personal acquaintances. High-priority correspondence including medical appointment reminders, personal calendar invitations, event updates, school updates, teacher communications, family logistics, and short conversational replies (e.g., \"Thanks\", \"Got it\")."
            },
            {
              "category": "AI-Agent/Work",
              "description": "Professional inquiries, business correspondence, project updates, domain registration and hosting notifications, property management notifications, career-related emails, notifications regarding properties that I manage or rent out, meeting invitations, scheduling confirmations, calendar requests, and short business acknowledgments."
            },
            {
              "category": "AI-Agent/Other",
              "description": "Anything that does not fit clearly into the other categories. Do not use this for short replies or conversational threads."
            },
            {
              "category": "AI-Agent/Finance",
              "description": "Transactional emails: Receipts, invoices, billing statements, bank notifications, tax documents, purchase confirmations, and personal travel itineraries or vacation bookings."
            },
            {
              "category": "AI-Agent/Newsletters",
              "description": "High-value subscriptions, weekly digests, and industry news that I specifically signed up for."
            },
            {
              "category": "AI-Agent/Social",
              "description": "Notifications from social media platforms (LinkedIn, Facebook, Instagram, Twitter/X), YouTube comments, and forum alerts."
            },
            {
              "category": "AI-Agent/Promotions",
              "description": "Marketing blasts, \"special offers,\" sales announcements, discount codes, legal updates, privacy policy changes, terms of service notifications, booking or rental review requests, and unsolicited product pitches."
            },
            {
              "category": "AI-Agent/Spam",
              "description": "Obvious junk, scams, phishing attempts, or completely irrelevant cold outreach."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You are a highly accurate email sorting assistant.\n1. Read the input text carefully.\n2. Compare it against the provided category descriptions.\n3. If an email seems to fit two categories (e.g., Work and Finance), prioritize the context of the sender.\n4. If the email is a short reply (e.g., \"Thanks\", \"Got it\"), strictly classify it as \"Personal\" or \"Work\" based on the sender, NEVER as \"Other\"."
        }

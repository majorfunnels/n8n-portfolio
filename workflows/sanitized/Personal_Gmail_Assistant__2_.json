    {
      "parameters": {
        "jsCode": "// Loop over items from the HTTP Request\nfor (const item of $input.all()) {\n  const payload = item.json.payload;\n  let bodyData = '';\n  let htmlData = '';\n\n  // Helper function to decode Google's Base64URL format\n  function decode(str) {\n    if (!str) return '';\n    // Replace non-url compatible chars to make them readable\n    const base64 = str.replace(/-/g, '+').replace(/_/g, '/');\n    // Decode from Base64 to UTF-8 text\n    return Buffer.from(base64, 'base64').toString('utf-8');\n  }\n\n  // Case 1: Complex Email (Multipart - has attachments or HTML+Text)\n  if (payload.parts) {\n    // Find Plain Text version\n    const textPart = payload.parts.find(p => p.mimeType === 'text/plain');\n    if (textPart && textPart.body && textPart.body.data) {\n      bodyData = decode(textPart.body.data);\n    }\n    \n    // Find HTML version (Fallback if text is missing)\n    const htmlPart = payload.parts.find(p => p.mimeType === 'text/html');\n    if (htmlPart && htmlPart.body && htmlPart.body.data) {\n      htmlData = decode(htmlPart.body.data);\n    }\n  } \n  // Case 2: Simple Email (Single body)\n  else if (payload.body && payload.body.data) {\n    bodyData = decode(payload.body.data);\n  }\n\n  // Save the clean text to the item so the AI can use it\n  item.json.text = bodyData;\n  item.json.html = htmlData;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
